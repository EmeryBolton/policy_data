<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whistler Agenda Theme Trends (2010 - 2071)</title>
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        body { font-family: sans-serif; background-color: #f9f9f9; padding: 20px; }
        #chart-container { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 1000px; margin: auto; position: relative;}
        .tooltip {
            position: absolute;
            text-align: left;
            padding: 8px 12px;
            font-size: 14px;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            border-radius: 4px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.2s;
        }
        h2 { text-align: center; color: #333; }
        .legend { font-size: 12px; }
    </style>
</head>
<body>

<div id="chart-container">
    <h2>Whistler Agenda Theme Trends (2010 - 2071)</h2>
    <div id="chart"></div>
    <div id="tooltip" class="tooltip"></div>
</div>

<script>
    // 1. Setup the full dataset (Normalized to 100% per year)
    const data = [
        {"year": 2010, "1. Tourism and visitor economy": 0.1014, "2. Environment & climate challenges": 0.0468, "3. Resort development and land use regulation": 0.0771, "4. Housing and workforce accommodation": 0.198, "5. Municipal service and administration / destination governance": 0.5766}, 
        {"year": 2011, "1. Tourism and visitor economy": 0.3271, "2. Environment & climate challenges": 0.0397, "3. Resort development and land use regulation": 0.1147, "4. Housing and workforce accommodation": 0.0786, "5. Municipal service and administration / destination governance": 0.4399}, 
        {"year": 2012, "1. Tourism and visitor economy": 0.2448, "2. Environment & climate challenges": 0.027, "3. Resort development and land use regulation": 0.2178, "4. Housing and workforce accommodation": 0.0176, "5. Municipal service and administration / destination governance": 0.4929}, 
        {"year": 2013, "1. Tourism and visitor economy": 0.0566, "2. Environment & climate challenges": 0.2797, "3. Resort development and land use regulation": 0.2763, "4. Housing and workforce accommodation": 0.0208, "5. Municipal service and administration / destination governance": 0.3666}, 
        {"year": 2014, "1. Tourism and visitor economy": 0.0856, "2. Environment & climate challenges": 0.1107, "3. Resort development and land use regulation": 0.1556, "4. Housing and workforce accommodation": 0.0347, "5. Municipal service and administration / destination governance": 0.6133}, 
        {"year": 2015, "1. Tourism and visitor economy": 0.0724, "2. Environment & climate challenges": 0.332, "3. Resort development and land use regulation": 0.1435, "4. Housing and workforce accommodation": 0.0217, "5. Municipal service and administration / destination governance": 0.4304}, 
        {"year": 2016, "1. Tourism and visitor economy": 0.0531, "2. Environment & climate challenges": 0.2095, "3. Resort development and land use regulation": 0.5119, "4. Housing and workforce accommodation": 0.0095, "5. Municipal service and administration / destination governance": 0.216}, 
        {"year": 2017, "1. Tourism and visitor economy": 0.025, "2. Environment & climate challenges": 0.4239, "3. Resort development and land use regulation": 0.196, "4. Housing and workforce accommodation": 0.0935, "5. Municipal service and administration / destination governance": 0.2616}, 
        {"year": 2018, "1. Tourism and visitor economy": 0.0311, "2. Environment & climate challenges": 0.5178, "3. Resort development and land use regulation": 0.0881, "4. Housing and workforce accommodation": 0.0123, "5. Municipal service and administration / destination governance": 0.3508}, 
        {"year": 2019, "1. Tourism and visitor economy": 0.0804, "2. Environment & climate challenges": 0.2007, "3. Resort development and land use regulation": 0.4636, "4. Housing and workforce accommodation": 0.0063, "5. Municipal service and administration / destination governance": 0.249}, 
        {"year": 2020, "1. Tourism and visitor economy": 0.0163, "2. Environment & climate challenges": 0.13, "3. Resort development and land use regulation": 0.7405, "4. Housing and workforce accommodation": 0.007, "5. Municipal service and administration / destination governance": 0.1061}, 
        {"year": 2021, "1. Tourism and visitor economy": 0.016, "2. Environment & climate challenges": 0.187, "3. Resort development and land use regulation": 0.6999, "4. Housing and workforce accommodation": 0.0068, "5. Municipal service and administration / destination governance": 0.0903}, 
        {"year": 2022, "1. Tourism and visitor economy": 0.0138, "2. Environment & climate challenges": 0.1428, "3. Resort development and land use regulation": 0.7179, "4. Housing and workforce accommodation": 0.0075, "5. Municipal service and administration / destination governance": 0.118}, 
        {"year": 2023, "1. Tourism and visitor economy": 0.0264, "2. Environment & climate challenges": 0.1568, "3. Resort development and land use regulation": 0.7386, "4. Housing and workforce accommodation": 0.0105, "5. Municipal service and administration / destination governance": 0.0678}, 
        {"year": 2024, "1. Tourism and visitor economy": 0.02, "2. Environment & climate challenges": 0.1747, "3. Resort development and land use regulation": 0.7283, "4. Housing and workforce accommodation": 0.0074, "5. Municipal service and administration / destination governance": 0.0695}, 
        {"year": 2025, "1. Tourism and visitor economy": 0.0302, "2. Environment & climate challenges": 0.1609, "3. Resort development and land use regulation": 0.695, "4. Housing and workforce accommodation": 0.0053, "5. Municipal service and administration / destination governance": 0.1086}, 
        {"year": 2066, "1. Tourism and visitor economy": 0.0065, "2. Environment & climate challenges": 0.1246, "3. Resort development and land use regulation": 0.0588, "4. Housing and workforce accommodation": 0.0001, "5. Municipal service and administration / destination governance": 0.81}, 
        {"year": 2071, "1. Tourism and visitor economy": 0.042, "2. Environment & climate challenges": 0.1128, "3. Resort development and land use regulation": 0.2493, "4. Housing and workforce accommodation": 0.0086, "5. Municipal service and administration / destination governance": 0.5873}
    ];

    const keys = [
        "1. Tourism and visitor economy",
        "2. Environment & climate challenges",
        "3. Resort development and land use regulation",
        "4. Housing and workforce accommodation",
        "5. Municipal service and administration / destination governance"
    ];

    // 2. Setup SVG dimensions
    const width = 1000;
    const height = 500;
    const margin = { top: 20, right: 300, bottom: 40, left: 60 };

    const svg = d3.select("#chart").append("svg")
        .attr("viewBox", [0, 0, width, height])
        .style("max-width", "100%")
        .style("height", "auto");

    // 3. Setup Scales
    const x = d3.scaleLinear()
        .domain(d3.extent(data, d => d.year))
        .range([margin.left, width - margin.right]);

    const color = d3.scaleOrdinal()
        .domain(keys)
        .range(["#66c2a5", "#fc8d62", "#8da0cb", "#e78ac3", "#a6d854"]);

    // 4. Setup Stack with WIGGLE offset
    const stack = d3.stack()
        .keys(keys)
        .order(d3.stackOrderInsideOut)
        .offset(d3.stackOffsetWiggle);

    const series = stack(data);

    // 5. Y-Scale dynamic extent
    const y = d3.scaleLinear()
        .domain([d3.min(series, d => d3.min(d, d => d[0])), d3.max(series, d => d3.max(d, d => d[1]))])
        .range([height - margin.bottom, margin.top]);

    // 6. Draw Axes
    svg.append("g")
        .attr("transform", `translate(0,${height - margin.bottom})`)
        .call(d3.axisBottom(x).ticks(16).tickFormat(d3.format("d")))
        .call(g => g.select(".domain").remove());

    svg.append("g")
        .attr("transform", `translate(${margin.left},0)`)
        .call(d3.axisLeft(y).ticks(5))
        .call(g => g.select(".domain").remove())
        .call(g => g.append("text")
            .attr("x", -margin.left)
            .attr("y", 10)
            .attr("fill", "currentColor")
            .attr("text-anchor", "start")
            .text("Theme Weight Distribution"));

    // 7. Draw Stream Area with CATMULL-ROM curve
    const area = d3.area()
        .x(d => x(d.data.year))
        .y0(d => y(d[0]))
        .y1(d => y(d[1]))
        .curve(d3.curveCatmullRom);

    const tooltip = d3.select("#tooltip");

    const paths = svg.append("g")
        .selectAll("path")
        .data(series)
        .join("path")
        .attr("fill", d => color(d.key))
        .attr("d", area)
        .style("cursor", "pointer")
        .on("mousemove", function(event, d) {
            paths.style("opacity", 0.2);
            d3.select(this).style("opacity", 1);

            const [mouseX, mouseY] = d3.pointer(event);
            const hoveredYear = Math.round(x.invert(mouseX));
            
            // Find the closest data point (handles the gap between 2025 and 2066 smoothly)
            const yearData = data.reduce((prev, curr) => 
                Math.abs(curr.year - hoveredYear) < Math.abs(prev.year - hoveredYear) ? curr : prev
            );

            if(yearData) {
                const value = yearData[d.key];
                tooltip.style("opacity", 1)
                    .html(`<strong>Year:</strong> ${yearData.year}<br><strong>Theme:</strong> ${d.key}<br><strong>Share:</strong> ${(value * 100).toFixed(1)}%`)
                    .style("left", (event.pageX + 15) + "px")
                    .style("top", (event.pageY - 28) + "px");
            }
        })
        .on("mouseout", function() {
            paths.style("opacity", 1);
            tooltip.style("opacity", 0);
        });

    // 8. Draw Legend
    const legend = svg.append("g")
        .attr("transform", `translate(${width - margin.right + 20}, ${margin.top})`)
        .attr("class", "legend")
        .selectAll("g")
        .data(keys.slice().reverse())
        .join("g")
        .attr("transform", (d, i) => `translate(0, ${i * 25})`);

    legend.append("rect")
        .attr("width", 15)
        .attr("height", 15)
        .attr("fill", color);

    legend.append("text")
        .attr("x", 24)
        .attr("y", 8)
        .attr("dy", "0.32em")
        .text(d => d)
        .style("font-size", "12px")
        .call(wrap, 250); 

    function wrap(text, width) {
        text.each(function() {
            let text = d3.select(this),
                words = text.text().split(/\s+/).reverse(),
                word,
                line = [],
                lineNumber = 0,
                lineHeight = 1.1,
                y = text.attr("y"),
                dy = parseFloat(text.attr("dy")),
                tspan = text.text(null).append("tspan").attr("x", 24).attr("y", y).attr("dy", dy + "em");
            while (word = words.pop()) {
                line.push(word);
                tspan.text(line.join(" "));
                if (tspan.node().getComputedTextLength() > width) {
                    line.pop();
                    tspan.text(line.join(" "));
                    line = [word];
                    tspan = text.append("tspan").attr("x", 24).attr("y", y).attr("dy", ++lineNumber * lineHeight + dy + "em").text(word);
                }
            }
        });
    }
</script>

</body>
</html>
